{
  "appId": "com.youngapps.traverse",
  "appName": "Traverse",
  "webDir": "dist",
  "ios": {
    "contentInset": "always"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com", "apple.com"]
    }
  },
  "server": {
    "allowNavigation": [
      "*.mapbox.com",
      "*.googleapis.com",
      "*.firebase.com",
      "*.firebaseio.com",
      "*.firebaseapp.com",
      "fonts.googleapis.com",
      "fonts.gstatic.com"
    ]
  }
}
