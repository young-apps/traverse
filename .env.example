# Firebase config — get from Firebase Console → Project Settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mapbox public token — get from https://account.mapbox.com
VITE_MAPBOX_TOKEN=

# Google Places API key — get from https://console.cloud.google.com
# Enable "Places API (New)" and "Maps JavaScript API"
VITE_GOOGLE_PLACES_KEY=
